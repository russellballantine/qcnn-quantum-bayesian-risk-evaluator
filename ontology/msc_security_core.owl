    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CollateralDamagePotential -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CollateralDamagePotential">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Collateral DP = case TargetDistribution of
                                 none:0
                                 low:0.1
                                 low-medium:0.3
                                 medium-high:0.4
                                 high:0.5
                                 not defined:0</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ConfImpact -->


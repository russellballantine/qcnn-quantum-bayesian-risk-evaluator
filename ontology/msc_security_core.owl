        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RemLevel_tempFix</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemLevel_unavailable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemLevel_unavailable">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemediationLevel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RemLevel_unavailable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemLevel_workaround -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemLevel_workaround">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemediationLevel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RemLevel_workaround</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemediationLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#RemediationLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RemediationLevel = case RemediationLevel of
                                official-fix:0.87
                                temp-fix: 0.90
                                workaround: 0.95
                                unavailable: 1.00
                                not defined:1.00</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ReportConfidence -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ReportConfidence">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_high -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_high">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_low -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_low">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_med -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_med">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_none -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_none">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_notDefined -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TD_notDefined">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TargetDistribution">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TargetDistribution = case TargetDistribution of
                                 none:0
                                 low:0.25
                                 medium:0.75
                                 high:1.0
                                 not defined:1.0</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TemporalScoreValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#TemporalScoreValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Asset -->

    <owl:Class rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Asset">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assets which are subject to vulnerabilities which can be exploited by threats.

When the assets are created they are assigned values for the CVSS metrics covering confidentiality integrity and availability. 

THe modeller should assign the relative importance values CR, IR and AR. The impact values are obtained from the base vector. The impact values are adjusted later by any countermeasures that are defined.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE -->

    <owl:Class rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Vulnerability"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NIST CVE vulnerabilities</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CVE</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl -->

    <owl:Class rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Asset"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Authentication"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Authentication -- Changes Authentication AC_high
        Level1 - Password == 0.704
        Level2 - SSH key == 0.56
        Level3 -- LDAP == 0.45
SecurityTraining -- changes CDP and Exploitability
        CDP
        Level1 - None or not defined == 0
        Level2 - Adhoc CBT == 0.1
        Level3 - CBT(periodic) == 0.3
        Level4 - Professional Cert == 0.5
        Exploitability
        Level1 - no accountability == 1.0
        Level2 - some accountability == 0.9
        Level3 - personnel fully accountable == 0.85
System Security Audit - Changes Target Distribution
        Level1 - None == 1.0
        Level2 - Adhoc == 0.75
        Level3 - Periodic system audits == 0.25
Intrusion Detection - Changes Integrity Impact
        Level1 - None == 0.66
        Level2 - Virus guard == 0.275
        Level3 - Full IPS/IDS and virus guard == 0
Disaster Recovery - Changes availability impact
        Level1 - None == 0.66
        Level2 - Local server backups == 0.275
        Level3 - SAN storage and cloud backups == 0</rdfs:comment>
        <rdfs:label>Countermeasures</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Threat -->

    <owl:Class rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Threat">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The threat component of the analysis is visible in the Bayesian Network representation. Might be visualised here for completeness later on but is not necessary at present.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Threat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Vulnerability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Vulnerability">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vulnerability</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ApplicationSandboxApplies -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ApplicationSandboxApplies">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl"/>
        <CollateralDamagePotential rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</CollateralDamagePotential>
        <CostMetric rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</CostMetric>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ApplicationWhitelistingApplies -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#ApplicationWhitelistingApplies">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl"/>
        <CollateralDamagePotential rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</CollateralDamagePotential>
        <CostMetric rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</CostMetric>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AxwayFileTransfer -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AxwayFileTransfer">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Asset"/>
        <hasVulnerability rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2019-14277"/>
        <AvailImpact rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.275</AvailImpact>
        <AvailReq rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</AvailReq>
        <ConfImpact rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.660</ConfImpact>
        <ConfReq rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.51</ConfReq>
        <IntegImpact rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.660</IntegImpact>
        <IntegReq rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.51</IntegReq>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This constitutes the hardware platform and the data that is transferred by the platform. In a more extensive model, the data can be seperated from the hardware.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindFirewall -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindFirewall">
        <owl:sameAs rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindNetworkFirewall"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindHostFirewall -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindHostFirewall">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl"/>
        <AccessVector rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.395</AccessVector>
        <CostMetric rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</CostMetric>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Host contains its own firewall. Moves security to a local status.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindNetworkFirewall -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindNetworkFirewall">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl"/>
        <AccessVector rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.646</AccessVector>
        <CostMetric rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.267</CostMetric>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Network location is behind a firewall protected infrastructure. This moves the network security to an &apos;adjacent&apos; status.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BehindNetworkFirewall</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CERTauthentication -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CERTauthentication">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl"/>
        <Authentication rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.56</Authentication>
        <CostMetric rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.01</CostMetric>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2002-0392 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2002-0392">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE"/>
        <AccessComplexity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.71</AccessComplexity>
        <AccessVector rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</AccessVector>
        <Authentication rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.704</Authentication>
        <BaseScoreValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.5</BaseScoreValue>
        <CollateralDamagePotential rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</CollateralDamagePotential>
        <Exploitability rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</Exploitability>
        <RemediationLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.87</RemediationLevel>
        <ReportConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</ReportConfidence>
        <TargetDistribution rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.25</TargetDistribution>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vulnerability on Apache web server (1.3 to 2.0.36)

Vector: (AV:N/AC:L/Au:N/C:P/I:P/A:P)</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.5</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CVE-2002-0392</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2010-00491 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2010-00491">
        <AccessComplexity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.61</AccessComplexity>
        <AccessVector rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</AccessVector>
        <Authentication rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.704</Authentication>
        <BaseScoreValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9.3</BaseScoreValue>
        <CollateralDamagePotential rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</CollateralDamagePotential>
        <Exploitability rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.00</Exploitability>
        <RemediationLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.87</RemediationLevel>
        <ReportConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.00</ReportConfidence>
        <TargetDistribution rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.75</TargetDistribution>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vulnerability on windows workstation

Vector: (AV:N/AC:M/Au:N/C:C/I:C/A:C)</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9.3</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CVE-2010-0491</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2010-0483 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE-2010-0483">
        <rdf:type rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#CVE"/>
        <hasCountermeasure rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#BehindNetworkFirewall"/>
        <hasCountermeasure rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#DisasterRecoveryStrategyPartial"/>
        <hasCountermeasure rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#LDAPauthentication"/>
        <hasCountermeasure rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#NoPatchAvailable"/>
        <hasCountermeasure rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#PartialHardeiningPolicyApplies"/>
        <hasCountermeasure rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#PartialPipelineEncryption"/>
        <AccessComplexity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.35</AccessComplexity>
        <AccessVector rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</AccessVector>
        <Authentication rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.704</Authentication>
        <BaseScoreValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.6</BaseScoreValue>
        <CollateralDamagePotential rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</CollateralDamagePotential>
        <Exploitability rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</Exploitability>
        <RemediationLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.87</RemediationLevel>
        <ReportConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</ReportConfidence>
        <TargetDistribution rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.75</TargetDistribution>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vulnerability on Windows2000 server


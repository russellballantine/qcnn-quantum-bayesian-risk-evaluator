    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Authentication -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Authentication">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiple instances of auth: 0.45
Single instance of auth: 0.56
No authentication: 0.704</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AvaiReq_low -->


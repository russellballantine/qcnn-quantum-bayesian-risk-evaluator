        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AvailReq = case AvailReq of
                                 not defined:1.0
                                 low:0.5
                                 medium:1.0
                                 high:1.51</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AvailReq_high -->


     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:untitled-ontology-49="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#decimal -->

    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#decimal">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DR strategy means probability of data or service disruption is reduced</rdfs:comment>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#hasCountermeasure -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#hasCountermeasure">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#SecurityControl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#hasExploitability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#hasExploitability"/>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#hasVulnerability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#hasVulnerability">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Asset"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Vulnerability"/>
    </owl:ObjectProperty>
    



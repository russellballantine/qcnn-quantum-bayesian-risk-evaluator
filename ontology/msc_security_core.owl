        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AV_network</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AccessComplexity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AccessComplexity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AccessComplexity = case AccessComplexity of
                                high:0.35
                                medium:0.61
                                low:0.71</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AccessVector -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#AccessVector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AccessVector = case AccessVector of
                                 local access needed:0.395
                                 adjacent network accessible:0.646
                                 network accessible: 1.0</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ballanr/ontologies/2021/2/untitled-ontology-49#Auth_multiple -->

